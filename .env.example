# Supabase PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/database"
DIRECT_URL="postgresql://user:password@host:6543/database"

# Server
PORT=3001
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Gmail SMTP for OTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="REWORE <your-sender@gmail.com>"

# Supabase Storage
# Buckets required:
# - id-cards: private
# - product-images: public
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy projects can use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...legacy-service-role-jwt...
