// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  SOLD
  AUCTION
  INACTIVE
  HIDDEN
  REMOVED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum AuctionStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum SellerProfileStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ReportTargetType {
  USER
  PRODUCT
  ORDER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportResolutionAction {
  WARN
  SUSPEND
  DISMISS
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  name         String
  avatar       String?
  bio          String?
  phone        String?
  address      String?
  role         Role      @default(BUYER)
  isBanned     Boolean   @default(false)
  bannedReason String?
  bannedAt     DateTime?
  reputation   Float     @default(0)
  totalSales   Int       @default(0)
  totalBids    Int       @default(0)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  products               Product[]
  auctions               Auction[]
  bids                   Bid[]
  ordersAsBuyer          Order[]               @relation("BuyerOrders")
  ordersAsSeller         Order[]               @relation("SellerOrders")
  wishlistItems          WishlistItem[]
  reviews                Review[]              @relation("ReviewsGiven")
  reviewsReceived        Review[]              @relation("ReviewsReceived")
  emailOtps              EmailOtp[]
  sellerProfile          SellerProfile?        @relation("SellerProfileOwner")
  reviewedSellerProfiles SellerProfile[]       @relation("SellerProfileReviewer")
  sellerStatusActions    SellerStatusHistory[] @relation("SellerStatusHistoryActor")
  reportsMade            Report[]              @relation("ReportsMade")
  reportsResolved        Report[]              @relation("ReportsResolved")
  adminActionLogs        AdminActionLog[]      @relation("AdminActionLogs")

  @@map("users")
}

model SellerProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  shopName          String
  idCardFrontUrl    String
  idCardBackUrl     String
  selfieUrl         String?
  bankAccountName   String
  bankAccountNumber String
  bankName          String
  pickupAddress     String
  status            SellerProfileStatus @default(PENDING)
  rejectedReason    String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user            User                  @relation("SellerProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByAdmin User?                 @relation("SellerProfileReviewer", fields: [reviewedBy], references: [id])
  statusHistory   SellerStatusHistory[]

  @@index([status])
  @@index([reviewedBy])
  @@map("seller_profiles")
}

model SellerStatusHistory {
  id              String               @id @default(cuid())
  sellerProfileId String
  fromStatus      SellerProfileStatus?
  toStatus        SellerProfileStatus
  actorId         String
  reason          String?
  createdAt       DateTime             @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  actor         User          @relation("SellerStatusHistoryActor", fields: [actorId], references: [id])

  @@index([sellerProfileId])
  @@index([actorId])
  @@map("seller_status_history")
}

model Product {
  id          String           @id @default(cuid())
  title       String
  description String
  price       Float
  images      String[]
  category    String
  condition   ProductCondition @default(GOOD)
  status      ProductStatus    @default(ACTIVE)
  brand       String?
  size        String?
  color       String?
  tags        String[]
  viewCount   Int              @default(0)
  sellerId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  auction       Auction?
  orderItems    Order[]
  wishlistItems WishlistItem[]

  @@map("products")
}

model Auction {
  id           String        @id @default(cuid())
  productId    String        @unique
  sellerId     String
  startPrice   Float
  currentBid   Float
  minIncrement Float         @default(1000)
  startTime    DateTime
  endTime      DateTime
  status       AuctionStatus @default(UPCOMING)
  winnerId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller  User    @relation(fields: [sellerId], references: [id])
  bids    Bid[]
  order   Order?

  @@map("auctions")
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Float
  isWinning Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@map("bids")
}

model Order {
  id              String        @id @default(cuid())
  buyerId         String
  sellerId        String
  productId       String?
  auctionId       String?       @unique
  totalPrice      Float
  shippingFee     Float         @default(0)
  paymentStatus   PaymentStatus @default(UNPAID)
  status          OrderStatus   @default(PENDING)
  qrCodeRef       String?
  shippingAddress String?
  note            String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  buyer   User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller  User     @relation("SellerOrders", fields: [sellerId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  auction Auction? @relation(fields: [auctionId], references: [id])

  @@map("orders")
}

model Report {
  id               String                  @id @default(cuid())
  reporterId       String
  targetType       ReportTargetType
  targetId         String
  reason           String
  status           ReportStatus            @default(OPEN)
  resolutionAction ReportResolutionAction?
  resolutionNote   String?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  reporter        User  @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedByAdmin User? @relation("ReportsResolved", fields: [resolvedBy], references: [id])

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

model AdminActionLog {
  id         String   @id @default(cuid())
  adminId    String
  actionType String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActionLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([actionType])
  @@map("admin_action_logs")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  revieweeId String
  orderId    String?
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  // Relations
  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  userId     String
  otpHash    String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@map("email_otps")
}
